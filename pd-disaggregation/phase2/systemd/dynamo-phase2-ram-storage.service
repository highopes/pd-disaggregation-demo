[Unit]
Description=Dynamo Phase 2 volatile RAM-backed storage
After=local-fs.target systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/dynamo-phase2/start-ram-storage.sh
ExecStop=/usr/local/libexec/dynamo-phase2/stop-ram-storage.sh
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
